# Soroban RPC endpoint (testnet default shown)
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint, used to check/create trustlines for classic-asset tokens (testnet default shown)
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Your deployed BalikBayan contract ID (from `stellar contract deploy`)
VITE_CONTRACT_ID=

# Escrow token contract ID on Stellar testnet.
# Leave unset to default to the native XLM Stellar Asset Contract (no trustline
# or funding step needed beyond the account's own XLM balance).
# Testnet USDC (Circle), if you want a stablecoin instead: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
VITE_TOKEN_CONTRACT_ID=

# Claude API key for AI receipt verification (server-side only)
ANTHROPIC_API_KEY=
